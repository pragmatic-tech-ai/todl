{
  "name": "@pragmatic-tech-ai/todl",
  "version": "0.34.0",
  "description": "Typed substrate for authoring and reasoning over ontologies and taxonomies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "require": "./dist/index.js"
    },
    "./language-service": {
      "types": "./dist/language-service/index.d.ts",
      "import": {
        "development": "./src/language-service/index.ts",
        "default": "./dist/language-service/index.js"
      },
      "require": "./dist/language-service/index.js"
    },
    "./language-server": {
      "types": "./dist/language-server/index.d.ts",
      "import": {
        "development": "./src/language-server/index.ts",
        "default": "./dist/language-server/index.js"
      },
      "require": "./dist/language-server/index.js"
    },
    "./package-manager": {
      "types": "./dist/solution-services/package-manager/index.d.ts",
      "import": {
        "development": "./src/solution-services/package-manager/index.ts",
        "default": "./dist/solution-services/package-manager/index.js"
      },
      "require": "./dist/solution-services/package-manager/index.js"
    },
    "./package-manager/connections": {
      "types": "./dist/solution-services/package-manager/engine/registry-connection.d.ts",
      "import": {
        "development": "./src/solution-services/package-manager/engine/registry-connection.ts",
        "default": "./dist/solution-services/package-manager/engine/registry-connection.js"
      },
      "require": "./dist/solution-services/package-manager/engine/registry-connection.js"
    },
    "./build-services": {
      "types": "./dist/solution-services/build-services/index.d.ts",
      "import": {
        "development": "./src/solution-services/build-services/index.ts",
        "default": "./dist/solution-services/build-services/index.js"
      },
      "require": "./dist/solution-services/build-services/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": {
        "development": "./src/domain/index.ts",
        "default": "./dist/domain/index.js"
      },
      "require": "./dist/domain/index.js"
    }
  },
  "bin": {
    "todl-language-server": "./dist/language-server/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "test": "tsx --conditions=development --test \"src/**/*.test.ts\"",
    "test:corpus": "tsx --conditions=development --test \"shared/**/*.test.ts\" \"examples/**/*.test.ts\" \"examples/**/*.test.mts\" \"cli/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:demos": "tsc -p cli/tsconfig.json --noEmit",
    "gen:prelude": "node scripts/gen-prelude.mjs",
    "gen:scaffold": "node scripts/gen-scaffold.mjs",
    "compile:mu": "node scripts/compile-mu.mjs",
    "gen:corpus": "node scripts/gen-corpus.mjs",
    "gen:goldens": "tsx --conditions=development examples/tools/update-goldens.mts && npm run gen:corpus",
    "cli": "tsx --conditions=development cli/src/main.ts",
    "build": "npm run gen:prelude && npm run gen:scaffold && npm run compile:mu && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@pragmatic-tech-ai/mural": "^0.55.13",
    "@pragmatic-tech-ai/todl-runtime": "^0.5.4",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
