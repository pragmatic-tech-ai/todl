namespace tech_architecture
{
    taxonomy actors : represents actor
    {
        description = """
            Classifies actors by their relationship to the enterprise trust
            boundary. Drives visual treatment in the architecture viewer and
            informs scenario validation.
            """;

        annotate toolbox { visible = true; }

        term internal
        {
            label = "Internal";
            description = """
                Authenticated party inside the enterprise — employees,
                contractors, operations stakeholders. Authenticates via the
                enterprise identity provider; sees internal applications.
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term external
        {
            label = "External";
            description = """
                Unauthenticated or partner_trust party outside the enterprise.
                Reaches the system only through public surfaces (public_api,
                partner_integration_endpoint, public_mcp_server).
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term business
        {
            label = "Business";
            description = """
                Internal party focused on business outcomes — line-of-business
                users, product managers, business analysts. Consumes internal
                applications to run day-to-day operations and decisions.
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term administration
        {
            label = "Administration";
            description = """
                Internal party responsible for administering business processes
                and enterprise applications — HR, finance, compliance, records
                admins. Typically holds elevated app-level privileges.
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term support
        {
            label = "Support";
            description = """
                Internal party handling customer or user support — help desk,
                field support, tier-N escalation. Interacts with case-management
                and observability surfaces to diagnose and resolve issues.
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term it_administration
        {
            label = "IT Administration";
            description = """
                Internal party responsible for the platform itself — SRE,
                platform engineers, cloud/IT operators. Holds elevated
                infrastructure privileges and manages tenants, subscriptions,
                networks, and shared services.
                """;
            annotate icon { path = "resources/user.svg"; }
        }

        term external_ai
        {
            label = "External AI Agent";
            description = """
                Autonomous agent operated by a third party that interacts with
                the enterprise via published machine surfaces (public_mcp_server,
                partner_integration_endpoint). Distinct from `external` because
                the semantics of agent_driven traffic differ — different rate
                limits, different audit trails, different consent model. Worth a
                separate visual treatment so a viewer can tell at a glance which
                actors are humans vs which are agents.
                """;
         annotate icon {path = "resources/ai-agent.svg"; }
        }
    }
}
