// AWS technology library — enriched from aws.discovery_report.md.
// 258 technologies grouped by vendor section. Transitive `import default;`
// so categories cited in `applicable_to` resolve.
//
// Per_product icons resolved from maintenance/icons_fallback/ (AWS official
// Architecture_Service_Icons set, 01302026 release). Each `annotate icon`
// block points to resources/<slug>.svg; runtime falls through to
// category_level rendering only when no per_service icon is available
// (13 entries).

namespace libraries.aws
{
    import tech_architecture;

    taxonomy aws_tech : represents location, technology uses categories
    {
        annotate toolbox { visible = true; }

        // ── Locations ───────────────────────────────────────────────
        // AWS_stack hosting tiers. `type` composes location_type flags
        // via `|` (spec §6.5).
        location aws                  { label = "AWS";                    type = cloud | paas; }
        location aws_govcloud         { label = "AWS GovCloud (US)";      type = cloud | paas; parent = aws; }
        location aws_china            { label = "AWS China";              type = cloud | paas; parent = aws; }
        location aws_local_zones      { label = "AWS Local Zones";        type = cloud | paas; parent = aws; }
        location aws_wavelength_zones { label = "AWS Wavelength Zones";   type = cloud | paas; parent = aws; }
        location aws_outposts         { label = "AWS Outposts";           type = physical | on_premises; }

