    scenario avd_user_launches_published_app {
      label = "User Launches Published App";
      outcome = "An end user connects through the AVD workspace, is directed to a RemoteApp application group backed by a pooled host pool, and lands on a session host VM";
      sequences = sequence {
        id = "user_to_session_host";
        entry_point = avd_end_user;
        steps = [avd_end_user ==> avd_avd_workspace_comp, avd_avd_workspace_comp ==> avd_avd_app_group_remoteapp, avd_avd_app_group_remoteapp ==> avd_avd_pooled_host_pool, avd_avd_pooled_host_pool ==> avd_session_hosts_vmss];
      };
    }
    scenario avd_fslogix_profile_load {
      label = "FSLogix Profile Load";
      outcome = "A session host mounts the user's FSLogix profile container from Azure Files Premium over a private endpoint";
      sequences = sequence {
        id = "session_host_to_fslogix";
        entry_point = avd_session_hosts_vmss;
        steps = [avd_session_hosts_vmss ==> avd_fslogix_files_pl, avd_fslogix_files_pl ==> avd_fslogix_files];
      };
    }
    scenario avd_scaling_plan_expansion {
      label = "Scaling Plan Expansion";
      outcome = "An AVD administrator jumps in via Bastion and scales out the pooled host pool by adding session hosts to the VMSS";
      sequences = sequence {
        id = "admin_scales_pool";
        entry_point = avd_avd_admin;
        steps = [avd_avd_admin ==> avd_bastion, avd_bastion ==> avd_avd_pooled_host_pool, avd_avd_pooled_host_pool ==> avd_session_hosts_vmss];
      };
