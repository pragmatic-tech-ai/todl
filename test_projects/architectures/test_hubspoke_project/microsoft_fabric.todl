    scenario fab_ingestion_medallion {
      label = "Ingestion Medallion";
      outcome = "Data engineer triggers ingest pipeline that lands raw data from Blob into Bronze, then a Silver dataflow cleanses into Silver, and a Gold semantic model curates into Gold";
      sequences = sequence {
        id = "ingestion_medallion";
        entry_point = fab_data_engineer;
        steps = [fab_data_engineer ==> fab_ingest_pipeline, fab_ingest_pipeline ==> fab_blob_source_pl, fab_blob_source_pl ==> fab_blob_source, fab_ingest_pipeline ==> fab_bronze_workspace, fab_bronze_workspace ==> fab_silver_dataflow, fab_silver_dataflow ==> fab_silver_workspace, fab_silver_workspace ==> fab_gold_semantic_model, fab_gold_semantic_model ==> fab_gold_workspace];
      };
    }
    scenario fab_realtime_alert {
      label = "Real-time Alert";
      outcome = "Real-time telemetry flows into an Eventhouse and materializes as a curated Gold workspace asset for alerting";
      sequences = sequence {
        id = "realtime_alert";
        entry_point = fab_data_engineer;
        steps = [fab_data_engineer ==> fab_realtime_eventhouse, fab_realtime_eventhouse ==> fab_gold_workspace];
      };
    }
    scenario fab_report_consumption {
      label = "Report Consumption";
      outcome = "A report consumer browses the Gold workspace and reads through the curated semantic model";
      sequences = sequence {
        id = "report_consumption";
        entry_point = fab_report_consumer;
        steps = [fab_report_consumer ==> fab_gold_workspace, fab_gold_workspace ==> fab_gold_semantic_model];
      };
