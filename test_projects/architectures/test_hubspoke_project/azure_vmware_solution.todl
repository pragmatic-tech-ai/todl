      label = "Production";
      environment = avs_hub_prod;
      in_resource_group = avs_platform_rg;
    }
    scenario avs_hcx_migration {
      label = "On-Prem to AVS Migration via HCX";
      outcome = "An on-premises VMware workload is migrated into the AVS private cloud through HCX, landing on vSAN storage";
      sequences = sequence {
        id = "hcx_migration";
        entry_point = avs_on_prem_workload;
        steps = [avs_on_prem_workload ==> avs_hcx_manager_comp, avs_hcx_manager_comp ==> avs_avs_private_cloud_comp, avs_avs_private_cloud_comp ==> avs_vsan_datastore];
      };
    }
    scenario avs_egress_via_hub_firewall {
      label = "AVS VM Egress via Hub Firewall";
      outcome = "An AVS-hosted VM egresses through NSX-T Edge and is inspected by the hub Azure Firewall before leaving the environment";
      sequences = sequence {
        id = "avs_egress";
        entry_point = avs_avs_private_cloud_comp;
        steps = [avs_avs_private_cloud_comp ==> avs_nsx_t_edge_comp, avs_nsx_t_edge_comp ==> avs_azure_firewall_hub];
      };
    }
    scenario avs_srm_dr {
      label = "ExpressRoute Global Reach Connectivity + SRM DR";
      outcome = "An administrator initiates a Site Recovery Manager DR operation against the AVS private cloud, with cross-region connectivity provided by ExpressRoute Global Reach at the tenant scope";
      sequences = sequence {
        id = "srm_dr";
        entry_point = avs_vsphere_admin;
        steps = [avs_vsphere_admin ==> avs_bastion, avs_bastion ==> avs_srm_comp, avs_srm_comp ==> avs_avs_private_cloud_comp];
      };
    }
