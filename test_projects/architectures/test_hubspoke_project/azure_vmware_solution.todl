    }
    subnet avs_pe_subnet {
      label = "Private Endpoints Subnet";
      cidr = "10.110.1.0/24";
      parent = avs_management_vnet;
    }
    environment avs_hub_prod {
      label = "Hub Production";
      kind = "environments.azure_subscription_env";
      lifecycle = "lifecycle_stages.prod";
      region = "eastus";
      in_tenant = avs_contoso_tenant;
      in_subscription = avs_connectivity_sub;
      resource_groups = [avs_hub_rg, avs_platform_rg];
