    }
    subnet hpc_fw_subnet {
      label = "AzureFirewallSubnet";
      cidr = "10.0.0.0/26";
      parent = hpc_hub_vnet;
    }
    subnet hpc_bastion_subnet {
      label = "AzureBastionSubnet";
      cidr = "10.0.0.64/26";
      parent = hpc_hub_vnet;
    }
    subnet hpc_shared_services_subnet {
      label = "Shared Services Subnet";
      cidr = "10.0.1.0/24";
      parent = hpc_hub_vnet;
    }
    network hpc_spoke_vnet {
      label = "HPC Spoke VNet";
      region = "eastus";
      kind = "networks.dedicated_network";
      cidr = "10.80.0.0/16";
      in = microsoft_tech.azure;
      in_subscription = hpc_workload_sub;
    }
    subnet hpc_head_node_subnet {
      label = "Head Node Subnet";
      cidr = "10.80.0.0/24";
      parent = hpc_spoke_vnet;
    }
    subnet hpc_compute_subnet {
      label = "Compute Subnet";
      cidr = "10.80.1.0/22";
      parent = hpc_spoke_vnet;
    }
    subnet hpc_scratch_subnet {
      label = "Scratch (Lustre) Subnet";
      cidr = "10.80.5.0/24";
      parent = hpc_spoke_vnet;
    }
    subnet hpc_pe_subnet {
      label = "Private Endpoints Subnet";
      cidr = "10.80.6.0/24";
      parent = hpc_spoke_vnet;
    }
    environment hpc_hub_prod {
      label = "Hub Production";
      kind = "environments.azure_subscription_env";
      lifecycle = "lifecycle_stages.prod";
      region = "eastus";
      in_tenant = hpc_contoso_tenant;
      in_subscription = hpc_connectivity_sub;
      resource_groups = [hpc_hub_rg, hpc_platform_rg];
    }
    environment hpc_prod {
      label = "HPC Workload Production";
      kind = "environments.azure_subscription_env";
      lifecycle = "lifecycle_stages.prod";
      region = "eastus";
      in_tenant = hpc_contoso_tenant;
      in_subscription = hpc_workload_sub;
      resource_groups = hpc_workload_rg;
    }
    component hpc_cyclecloud_head {
      label = "Azure CycleCloud Head Node";
      in = microsoft_tech.azure;
      implemented_by = hpc_cyclecloud;
      slots = hpc_cyclecloud_head_prod;
    }
    slot hpc_cyclecloud_head_prod {
      label = "Production";
      environment = hpc_prod;
      in_resource_group = hpc_workload_rg;
      in_subnet = hpc_head_node_subnet;
    }
    component hpc_slurm_scheduler_comp {
      label = "Slurm Scheduler";
      in = microsoft_tech.azure;
      implemented_by = hpc_slurm_scheduler;
      slots = hpc_slurm_scheduler_prod;
    }
    slot hpc_slurm_scheduler_prod {
      label = "Production";
      environment = hpc_prod;
      in_resource_group = hpc_workload_rg;
