      implemented_by = hpc_azure_log_analytics;
      slots = hpc_log_analytics_ws_prod;
    }
    slot hpc_log_analytics_ws_prod {
      label = "Production";
      environment = hpc_hub_prod;
      in_resource_group = hpc_platform_rg;
    }
    scenario hpc_job_submission {
      label = "Job Submission + Scale-Out";
      outcome = "A researcher connects via Bastion to CycleCloud, submits a job to Slurm, which schedules across HB and HC compute pools";
      sequences = sequence {
        id = "job_submit_scale_out";
        entry_point = hpc_researcher;
        steps = [hpc_researcher ==> hpc_bastion, hpc_bastion ==> hpc_cyclecloud_head, hpc_cyclecloud_head ==> hpc_slurm_scheduler_comp, hpc_slurm_scheduler_comp ==> hpc_hb_pool, hpc_slurm_scheduler_comp ==> hpc_hc_pool];
      };
    }
    scenario hpc_scratch_io {
      label = "Scratch Read/Write During Job";
      outcome = "Compute pools read and write intermediate results to the Managed Lustre scratch filesystem during job execution";
      sequences = sequence {
        id = "scratch_io";
        entry_point = hpc_hb_pool;
        steps = [hpc_hb_pool ==> hpc_lustre_scratch, hpc_hc_pool ==> hpc_lustre_scratch];
      };
    }
    scenario hpc_archive_results {
      label = "Archive Results";
      outcome = "On job completion the scheduler pushes final artifacts through a private endpoint to cool-tier archival blob storage";
      sequences = sequence {
        id = "archive_results";
        entry_point = hpc_slurm_scheduler_comp;
        steps = [hpc_slurm_scheduler_comp ==> hpc_archive_blob_pl, hpc_archive_blob_pl ==> hpc_archive_blob];
      };
    }
