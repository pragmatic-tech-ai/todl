      label = "HPC Operator";
    }
    tenant hpc_contoso_tenant {
      label = "Contoso Entra Tenant";
      region = "eastus";
      in = microsoft_tech.azure;
    }
    subscription hpc_connectivity_sub {
      label = "Connectivity Subscription";
      region = "eastus";
