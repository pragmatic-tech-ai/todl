      in_resource_group = saas_platform_rg;
    }
    scenario saas_tenant_onboarding {
      label = "Tenant Onboarding";
      outcome = "A tenant administrator signs up via the control plane; the orchestrator writes to the catalog and emits a provisioning event that materializes the tenant's stamp";
      sequences = sequence {
        id = "tenant_onboarding_flow";
        entry_point = saas_tenant_admin;
        steps = [saas_tenant_admin ==> saas_front_door, saas_front_door ==> saas_apim_gateway, saas_apim_gateway ==> saas_control_api, saas_control_api ==> saas_tenant_catalog_db, saas_control_api ==> saas_provisioning_event_grid, saas_provisioning_event_grid ==> saas_shared_stamp_app];
      };
    }
    scenario saas_shared_stamp_request {
      label = "End-User Request on Shared Stamp";
      outcome = "An end user hits Front Door, is routed to the shared stamp App Gateway, and served by the shared app tier with private-link data access";
      sequences = sequence {
        id = "shared_stamp_flow";
        entry_point = saas_end_user;
        steps = [saas_end_user ==> saas_front_door, saas_front_door ==> saas_shared_app_gateway, saas_shared_app_gateway ==> saas_shared_stamp_app, saas_shared_stamp_app ==> saas_shared_stamp_sql_pl, saas_shared_stamp_sql_pl ==> saas_shared_stamp_sql];
      };
    }
    scenario saas_dedicated_stamp_request {
      label = "Premium Tenant Request on Dedicated Stamp";
      outcome = "A premium tenant end user is routed to the dedicated stamp for tenant A, providing full isolation from noisy-neighbor tenants on the shared stamp";
      sequences = sequence {
        id = "dedicated_stamp_flow";
        entry_point = saas_end_user;
        steps = [saas_end_user ==> saas_front_door, saas_front_door ==> saas_dedicated_stamp_a_appgw, saas_dedicated_stamp_a_appgw ==> saas_dedicated_stamp_a_app, saas_dedicated_stamp_a_app ==> saas_dedicated_stamp_a_sql_pl, saas_dedicated_stamp_a_sql_pl ==> saas_dedicated_stamp_a_sql];
      };
    }
  }
