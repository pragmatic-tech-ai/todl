      label = "Production East";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
      in_subnet = orc_pe_subnet_east;
    }
    component orc_key_vault {
      label = "Azure Key Vault (Oracle secrets, wallet)";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.azure_key_vault;
      slots = orc_key_vault_prod;
    }
    slot orc_key_vault_prod {
      label = "Production East";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
    }
    component orc_key_vault_pl {
      label = "Key Vault Private Link";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.azure_private_link;
      slots = orc_key_vault_pl_prod;
    }
    slot orc_key_vault_pl_prod {
      label = "Production East";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
      in_subnet = orc_pe_subnet_east;
    }
    component orc_azure_firewall_hub_east {
      label = "Azure Firewall (hub East)";
