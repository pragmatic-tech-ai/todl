      in_resource_group = orc_oracle_rg_east;
      in_subnet = orc_db_subnet_east;
    }
    component orc_analytics_sink_blob {
      label = "Analytics Sink Blob";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.azure_blob_storage;
      slots = orc_analytics_sink_blob_prod;
    }
    slot orc_analytics_sink_blob_prod {
      label = "Production East";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
    }
    component orc_analytics_sink_blob_pl {
      label = "Analytics Sink Blob Private Link";
