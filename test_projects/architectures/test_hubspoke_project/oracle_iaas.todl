      label = "Microsoft Entra ID";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.microsoft_entra_id;
    }
    component orc_azure_dns {
      label = "Azure DNS (private zones)";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.azure_dns;
    }
    component orc_app_insights {
      label = "Application Insights";
      in = microsoft_tech.azure;
      implemented_by = orc_azure_application_insights;
      slots = orc_app_insights_prod;
    }
    slot orc_app_insights_prod {
      label = "Production";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_platform_rg;
    }
    component orc_log_analytics_ws {
      label = "Log Analytics Workspace";
      in = microsoft_tech.azure;
      implemented_by = orc_azure_log_analytics;
      slots = orc_log_analytics_ws_prod;
    }
    slot orc_log_analytics_ws_prod {
      label = "Production";
      environment = orc_hub_prod_east;
      in_resource_group = orc_platform_rg;
    }
    scenario orc_app_read_from_primary {
      label = "App Read from Primary";
      outcome = "End user hits the App Gateway, is routed to WebLogic on the app tier, which reads from the Oracle primary DB in the East region";
      sequences = sequence {
        id = "app_read_primary";
        entry_point = orc_end_user;
        steps = [orc_end_user ==> orc_app_gateway_east, orc_app_gateway_east ==> orc_weblogic_vmss, orc_weblogic_vmss ==> orc_oracle_primary_db];
      };
    }
    scenario orc_dr_failover {
      label = "DR Failover to Standby";
      outcome = "DBA triggers Data Guard failover; the standby DB in West is promoted to primary via redo apply managed by Data Guard";
      sequences = sequence {
        id = "dr_failover";
        entry_point = orc_dba;
        steps = [orc_dba ==> orc_bastion_east, orc_bastion_east ==> orc_data_guard_comp, orc_data_guard_comp ==> orc_oracle_standby_db];
      };
    }
    scenario orc_goldengate_cdc_to_analytics {
      label = "GoldenGate CDC to Analytics Sink";
      outcome = "Change data captured from the Oracle primary is replicated by GoldenGate into an analytics blob sink via private link, feeding downstream analytics consumers";
      sequences = sequence {
        id = "goldengate_cdc_sink";
        entry_point = orc_oracle_primary_db;
        steps = [orc_oracle_primary_db ==> orc_goldengate_comp, orc_goldengate_comp ==> orc_analytics_sink_blob_pl, orc_analytics_sink_blob_pl ==> orc_analytics_sink_blob];
      };
    }
