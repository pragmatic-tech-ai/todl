      in_subscription = orc_connectivity_sub_west;
      resource_groups = orc_hub_rg_west;
    }
    environment orc_oracle_prod_east {
      label = "Oracle Production (East, primary)";
      kind = "environments.azure_subscription_env";
      lifecycle = "lifecycle_stages.prod";
      region = "eastus";
      in_tenant = orc_contoso_tenant;
      in_subscription = orc_oracle_workload_sub_east;
      resource_groups = orc_oracle_rg_east;
    }
    environment orc_oracle_dr_west {
      label = "Oracle DR (West, standby)";
      kind = "environments.azure_subscription_env";
      lifecycle = "lifecycle_stages.dr";
      region = "westus2";
      in_tenant = orc_contoso_tenant;
      in_subscription = orc_oracle_workload_sub_west;
      resource_groups = orc_oracle_rg_west;
    }
    component orc_app_gateway_east {
      label = "Application Gateway + WAF (East)";
      in = microsoft_tech.azure;
      implemented_by = microsoft_tech.application_gateway;
      slots = orc_app_gateway_east_prod;
    }
    slot orc_app_gateway_east_prod {
      label = "Production East";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
      in_subnet = orc_appgw_subnet_east;
      public_ingress = ingresses.public_internet;
    }
    component orc_weblogic_vmss {
      label = "Oracle WebLogic VMSS";
      in = microsoft_tech.azure;
      implemented_by = orc_oracle_weblogic_vm;
      slots = orc_weblogic_vmss_prod;
    }
    slot orc_weblogic_vmss_prod {
      label = "Production East";
      environment = orc_oracle_prod_east;
