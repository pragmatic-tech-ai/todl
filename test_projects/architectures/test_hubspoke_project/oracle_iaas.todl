      in_subnet = orc_weblogic_subnet_east;
    }
    component orc_oracle_primary_db {
      label = "Oracle DB Primary (on VM, ASM-backed)";
      in = microsoft_tech.azure;
      implemented_by = orc_oracle_db_vm;
      slots = orc_oracle_primary_db_prod;
    }
    slot orc_oracle_primary_db_prod {
      label = "Production East (primary)";
      environment = orc_oracle_prod_east;
      in_resource_group = orc_oracle_rg_east;
      in_subnet = orc_db_subnet_east;
    }
    component orc_oracle_standby_db {
      label = "Oracle DB Standby (on VM)";
      in = microsoft_tech.azure;
      implemented_by = orc_oracle_db_vm;
      slots = orc_oracle_standby_db_dr;
    }
    slot orc_oracle_standby_db_dr {
      label = "DR West (standby)";
      environment = orc_oracle_dr_west;
      in_resource_group = orc_oracle_rg_west;
      in_subnet = orc_db_subnet_west;
    }
    component orc_data_guard_comp {
      label = "Oracle Data Guard (redo apply, physical standby)";
      in = microsoft_tech.azure;
      implemented_by = orc_oracle_data_guard;
    }
    component orc_goldengate_comp {
      label = "Oracle GoldenGate (CDC extract/replicat)";
      in = microsoft_tech.azure;
      implemented_by = orc_oracle_goldengate;
      slots = orc_goldengate_comp_prod;
    }
