    scenario mc_normal_request {
      label = "Normal Request (East Active)";
      outcome = "HTTPS request enters via Front Door, is routed by Traffic Manager to the East regional stamp, terminates at Application Gateway, is served by AKS, which reads/writes through the regional Cosmos DB private link";
      sequences = sequence {
        id = "normal_east_active";
        entry_point = mc_global_user;
        steps = [mc_global_user ==> mc_front_door, mc_front_door ==> mc_traffic_manager_comp, mc_traffic_manager_comp ==> mc_app_gateway_east, mc_app_gateway_east ==> mc_aks_east, mc_aks_east ==> mc_cosmos_db_east_pl, mc_cosmos_db_east_pl ==> mc_cosmos_db_east];
      };
    }
    scenario mc_regional_failover_west {
      label = "Regional Failover to West";
      outcome = "When East is unhealthy, Traffic Manager fails over to the West stamp; requests are served end-to-end from West with Cosmos DB multi-region writes providing local write capability";
      sequences = sequence {
        id = "failover_to_west";
        entry_point = mc_global_user;
        steps = [mc_global_user ==> mc_front_door, mc_front_door ==> mc_traffic_manager_comp, mc_traffic_manager_comp ==> mc_app_gateway_west, mc_app_gateway_west ==> mc_aks_west, mc_aks_west ==> mc_cosmos_db_west_pl, mc_cosmos_db_west_pl ==> mc_cosmos_db_west];
      };
    }
    scenario mc_chaos_experiment {
      label = "Chaos Experiment";
      outcome = "An operator uses Chaos Studio to inject a targeted fault against the East AKS cluster to validate the workload's resilience posture";
      sequences = sequence {
        id = "chaos_east";
        entry_point = mc_operator;
        steps = [mc_operator ==> mc_chaos_studio_comp, mc_chaos_studio_comp ==> mc_aks_east];
      };
    }
  }
