      label = "RG - AI Workload";
      region = "eastus";
      in_subscription = aiw_ai_workload_sub;
    }
    network aiw_hub_vnet {
      label = "Hub VNet";
      region = "eastus";
      kind = "networks.dedicated_network";
      cidr = "10.0.0.0/22";
      in = microsoft_tech.azure;
