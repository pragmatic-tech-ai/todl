    }
    component aiw_log_analytics_ws {
      label = "Log Analytics Workspace";
      in = microsoft_tech.azure;
      implemented_by = aiw_azure_log_analytics;
      slots = aiw_log_analytics_ws_prod;
    }
    slot aiw_log_analytics_ws_prod {
      label = "Production";
      environment = aiw_hub_prod;
      in_resource_group = aiw_platform_rg;
    }
    scenario aiw_rag_query {
      label = "RAG Query";
      outcome = "End-user prompt is filtered for safety, grounded against the AI Search index via the RAG orchestrator, answered by the PTU OpenAI deployment, and persisted to chat history";
      sequences = sequence {
        id = "rag_query";
        entry_point = aiw_end_user;
        steps = [aiw_end_user ==> aiw_front_door, aiw_front_door ==> aiw_apim_gateway, aiw_apim_gateway ==> aiw_content_safety_svc, aiw_apim_gateway ==> aiw_rag_orchestrator, aiw_rag_orchestrator ==> aiw_ai_search_pl, aiw_ai_search_pl ==> aiw_ai_search_comp, aiw_rag_orchestrator ==> aiw_openai_ptu_comp, aiw_rag_orchestrator ==> aiw_chat_history_cosmos_pl, aiw_chat_history_cosmos_pl ==> aiw_chat_history_cosmos];
      };
    }
    scenario aiw_ingestion_pipeline {
      label = "Ingestion Pipeline";
      outcome = "Data engineer securely accesses the orchestrator via Bastion to run an ingestion job that reads source documents from grounding blob storage, cracks them with Document Intelligence, and indexes them in AI Search";
      sequences = sequence {
        id = "ingestion_pipeline";
        entry_point = aiw_data_engineer;
        steps = [aiw_data_engineer ==> aiw_bastion, aiw_bastion ==> aiw_rag_orchestrator, aiw_rag_orchestrator ==> aiw_grounding_blob_pl, aiw_grounding_blob_pl ==> aiw_grounding_blob, aiw_rag_orchestrator ==> aiw_document_intelligence_svc, aiw_rag_orchestrator ==> aiw_ai_search_pl];
      };
    }
    scenario aiw_jailbreak_filtered {
      label = "Jailbreak Filtered";
      outcome = "A malicious prompt is intercepted by Content Safety at the APIM layer and never reaches the model";
      sequences = sequence {
        id = "jailbreak_filtered";
        entry_point = aiw_end_user;
        steps = [aiw_end_user ==> aiw_front_door, aiw_front_door ==> aiw_apim_gateway, aiw_apim_gateway ==> aiw_content_safety_svc];
      };
    }
