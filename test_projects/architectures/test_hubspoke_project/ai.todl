    }
    subnet aiw_fw_subnet {
      label = "AzureFirewallSubnet";
      cidr = "10.0.0.0/26";
      parent = aiw_hub_vnet;
    }
    subnet aiw_bastion_subnet {
      label = "AzureBastionSubnet";
      cidr = "10.0.0.64/26";
      parent = aiw_hub_vnet;
    }
    subnet aiw_shared_services_subnet {
      label = "Shared Services Subnet";
      cidr = "10.0.1.0/24";
      parent = aiw_hub_vnet;
    }
    network aiw_ai_spoke_vnet {
      label = "AI Workload Spoke VNet";
      region = "eastus";
      kind = "networks.dedicated_network";
      cidr = "10.50.0.0/20";
      in = microsoft_tech.azure;
      in_subscription = aiw_ai_workload_sub;
    }
    subnet aiw_apim_subnet {
      label = "APIM Subnet";
      cidr = "10.50.0.0/24";
      parent = aiw_ai_spoke_vnet;
    }
    subnet aiw_orchestrator_subnet {
      label = "Orchestrator Subnet";
